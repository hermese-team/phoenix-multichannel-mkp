# Copy to .env and fill in real values:  cp .env.example .env
# Load before running:  set -a; source .env; set +a
#
# NOTE: Lazada access/refresh tokens are NOT here — they live in Redis.
# Seed them once with:
#   make seed-lazada-token REFRESH=<refresh_token> [ACCESS=<access_token>]

# App
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Lazada Open Platform
LAZADA_APP_KEY=your_app_key
LAZADA_APP_SECRET=your_app_secret
LAZADA_URL_API=https://api.lazada.co.th/rest
LAZADA_AUTH_URL=https://auth.lazada.com/rest

# Optional — order id for the lazada-ping smoke test
LAZADA_ORDER_ID=

# Infra
POSTGRES_DSN=postgres://admin:admin@localhost:5432/marketplace_sync?sslmode=disable
REDIS_ADDR=localhost:6379

# Webhook idempotency key prefix (Redis)
LAZADA_WEBHOOK_IDEM_PREFIX=lazada:webhook:idem

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=marketplace-sync
LAZADA_WEBHOOK_TOPIC=lazada.order.webhook
LAZADA_WEBHOOK_GROUP=lazada-webhook-consumer

# Order-sync scheduler (optional overrides)
LAZADA_SYNC_SPEC=@every 5m
LAZADA_SYNC_WINDOW=24h
LAZADA_SYNC_LIMIT=50
