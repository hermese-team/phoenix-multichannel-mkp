# App
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=phoenix_mkp
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=phoenix-mkp
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_TOPIC_ORDER_CREATED=order.created
KAFKA_TOPIC_PRODUCT_UPDATED=product.updated

# Marketplaces (outbound APIs — mock URLs by default)
MARKETPLACE_TIKTOK_BASE_URL=https://mock.tiktok.local
MARKETPLACE_TIKTOK_API_KEY=
MARKETPLACE_TIKTOK_TIMEOUT=10s
MARKETPLACE_LAZADA_BASE_URL=https://mock.lazada.local
MARKETPLACE_LAZADA_API_KEY=
MARKETPLACE_LAZADA_TIMEOUT=10s
MARKETPLACE_SHOPEE_BASE_URL=https://mock.shopee.local
MARKETPLACE_SHOPEE_API_KEY=
MARKETPLACE_SHOPEE_TIMEOUT=10s
